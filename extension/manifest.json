{
  "manifest_version": 3,
  "name": "AI Shield",
  "version": "3.0.0",
  "description": "Detect AI-generated text, deepfake images, and phishing content. Local-first — no data leaves your machine.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Shield"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}